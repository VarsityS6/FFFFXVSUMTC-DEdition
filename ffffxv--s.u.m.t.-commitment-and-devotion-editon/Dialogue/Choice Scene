
 { "id": "Choice_intro_1", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Well, I finally made it to the Perpetually Stormy Climactic Field." }
  { "id": "Choice_intro_2", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Aptly named." },
  { "id": "Choice_intro_3", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Maybe something climactic will happen here:" },
  { "id": "Choice_intro_4", "speaker": "Jimmy", "portrait": "PlayerTalk.png", "text": "Nina! we need to talk to you!" },
  { "id": "Choice_intro_5", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "We all want to marry you but we can't decide who gets to." },
  { "id": "Choice_intro_6", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "They've been arguing about it for minutes." },
  { "id": "Choice_intro_7", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Wow that's..." },

   { "id": "Choice_intro_8", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "When did you guys have time to talk about this about this?" },
  { "id": "Choice_intro_9", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "I started walking up the hill to this field right after my last conversation." },
  { "id": "Choice_intro_10", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "We took the elevator." },
  { "id": "Choice_intro_11", "speaker": "Jimmy", "portrait": "PlayerTalk.png", "text": "You really walked up that entire hill??" },
  { "id": "Choice_intro_12", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "Yeah my feet are killing me." },
  { "id": "Choice_intro_13", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "Should've taken the elevator." },
  { "id": "Choice_intro_14", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Why the hell would there be an elevator to get to a field." },
   { "id": "Choice_intro_15", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "Because the hill is really steep." },
  { "id": "Choice_intro_16", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "Hey! We're getting distracted!." },
  { "id": "Choice_intro_17", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "We need to figure out who Nina is going to marry! And whether or not it's me!" },
  { "id": "Choice_intro_18", "speaker": "Jimmy", "portrait": "PlayerTalk.png", "text": "This is crazy! This seems really soon to talk about marrying any of you." },
  { "id": "Choice_intro_19", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "Of course she doesn't want to marry us. No one could ever love me. Not even my dad who is a dragon." },
  { "id": "Choice_intro_20", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "Enough about your dad already." },
  { "id": "Choice_intro_21", "speaker": "Jimmy", "portrait": "PlayerTalk.png", "text": "We are SO sick of hearing about it." },
   { "id": "Choice_intro_22", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Come on guys play nice." },
  { "id": "Choice_intro_23", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "Thank you Nina." },
  { "id": "Choice_intro_24", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "But seriously. Quit it with the dragon dad thing. It's weird." },
  { "id": "Choice_intro_25", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "sigh" },
  { "id": "Choice_intro_26", "speaker": "Charrax", "portrait": "PlayerTalk.png", "text": "I think we should let Nina pick who she wants to marry." },
  { "id": "Choice_intro_27", "speaker": "Taz", "portrait": "PlayerTalk.png", "text": "As long as she picks me." },
  { "id": "Choice_intro_28", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "Ok this is ridiculous. I'm not marrying any of you so soon." },
   { "id": "Choice_intro_29", "speaker": "", "portrait": "PlayerTalk.png", "text": "The game developers don't have time to make another scene so you should probably marry one of them right now." },
  { "id": "Choice_intro_30", "speaker": "Nina", "portrait": "PlayerTalk.png", "text": "You guys even got the narrator in on this!" },
  { "id": "Choice_intro_31", "speaker": "", "portrait": "PlayerTalk.png", "text": "What? I love to see love blossom." },
